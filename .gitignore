# Keep the repository source-only. New root entries require an explicit decision.
/*
!/.gitignore
!/src/
!/extension/
!/scripts/
!/tests/

# Local documentation and agent context must never be published.
*.[mM][dD]
[Dd]ocs/
[Dd]ocumentation/
[Mm]emory/
[Mm]emories/
.codex/
.agents/
.claude/
.cursor/

# Build outputs, generated reports, caches and editor state (at any depth).
artifacts/
bin/
obj/
build/
dist/
coverage/
test-results/
node_modules/
packages/
.vs/
.vscode/
__pycache__/
*.exe
*.dll
*.pdb
*.cache
*.log
*.tmp
*.bak
*.user
*.suo
*.zip
*.7z

# Local saves, machine-specific registration and credentials.
island.json*
native-host.json
.env
.env.*
.aws/
*.pem
*.key
*.pfx
*.p12
credentials*.json
secrets*.json
Thumbs.db
Desktop.ini
.DS_Store
