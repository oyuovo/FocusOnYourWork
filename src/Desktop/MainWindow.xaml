<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="专注宗门 · FocusOnYourWork" Width="1380" Height="920" MinWidth="1080" MinHeight="820"
 WindowStartupLocation="CenterScreen" Background="#193B35" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
 <Grid x:Name="SceneRoot" ClipToBounds="True">
  <ContentControl x:Name="SectHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid Margin="28,22,28,0" VerticalAlignment="Top" Height="72">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
    <Border BorderBrush="#8EB3BCA0" BorderThickness="1" Width="46" Height="46" CornerRadius="12" Background="#78203931" Margin="0,2,14,0">
     <Path Data="{DynamicResource Emblem}" Stroke="#E5D5AA" StrokeThickness="1.4" Width="25" Height="29" Stretch="Uniform"/>
    </Border>
    <StackPanel>
     <TextBox x:Name="SectName" MaxLength="20" Width="340" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource HudInk}" CaretBrush="White" BorderThickness="0" Padding="0" FontSize="25" FontWeight="SemiBold" ToolTip="宗门名称，离开输入框后保存"/>
     <TextBlock x:Name="SectSummary" Foreground="{DynamicResource HudMuted}" Margin="0,6,0,0"/>
    </StackPanel>
   </StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource HudGlass}" BorderBrush="#527D9686" BorderThickness="1" CornerRadius="10" Padding="18,10" VerticalAlignment="Top">
    <StackPanel Orientation="Horizontal"><TextBlock Text="材料" Foreground="{DynamicResource HudMuted}" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock x:Name="Wallet" Foreground="{DynamicResource HudInk}" FontSize="23"/></StackPanel>
   </Border>
  </Grid>
  <Grid Margin="28,112,28,126">
   <Border x:Name="FocusDrawer" Style="{StaticResource ScenePanel}" Width="390" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,18">
      <Button x:Name="CloseFocus" DockPanel.Dock="Right" Content="收起" Style="{StaticResource PanelCloseButton}" VerticalAlignment="Top"/>
      <StackPanel><TextBlock Text="静 心 修 行" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/><TextBlock x:Name="FocusHeading" Text="开启一段专注" FontSize="22" FontWeight="SemiBold"/></StackPanel>
     </DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
       <StackPanel x:Name="SetupPanel">
        <TextBlock Text="这次想完成什么" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
        <TextBox x:Name="TaskName" Text="读完一篇文章" MaxLength="100" Margin="0,0,0,15"/>
        <CheckBox x:Name="UseWindow" Content="在一个软件窗口里专注" IsChecked="True"/>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><ComboBox x:Name="WindowChoices" Margin="0,0,7,0"/><Button x:Name="RefreshWindows" Grid.Column="1" Content="刷新" Padding="5,5" Margin="0"/></Grid>
        <CheckBox x:Name="UseBrowser" Content="允许在选定的 Edge 页面阅读"/>
        <TextBlock x:Name="BrowserLabel" Text="尚未选择页面。在 Edge 扩展中点击“选为专注页面”。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,6"/>
        <Button x:Name="BrowserHelp" Content="如何连接 Edge" HorizontalAlignment="Left" Padding="9,5" Margin="0,0,0,15"/>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="分钟" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="Minutes" IsEditable="True" Text="25"><ComboBoxItem Content="5"/><ComboBoxItem Content="15"/><ComboBoxItem Content="25"/><ComboBoxItem Content="45"/><ComboBoxItem Content="60"/></ComboBox></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="专注方式" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="Mode" SelectedIndex="0"><ComboBoxItem Content="随心 · 返回继续"/><ComboBoxItem Content="挑战 · 完成额外 +20%"/></ComboBox></StackPanel>
        </Grid>
        <Button x:Name="StartButton" Content="开始专注" Padding="12,12" Margin="0"/>
        <TextBlock Text="开始后收起到托盘。离开目标范围时，暂停累计。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel x:Name="SessionPanel" Visibility="Collapsed">
        <TextBlock x:Name="ActiveTask" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="TimerText" Text="00:00" FontSize="52" Margin="0,12,0,0"/>
        <TextBlock x:Name="SessionStatus" Text="等待回到目标窗口" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <ProgressBar x:Name="SessionProgress" Height="6" Foreground="{DynamicResource Accent}" Background="#E9EDE4" BorderThickness="0"/>
        <TextBlock x:Name="SessionReward" TextWrapping="Wrap" Margin="0,16,0,18"/>
        <WrapPanel><Button x:Name="PauseButton" Content="暂停"/><Button x:Name="HideButton" Content="收起继续"/><Button x:Name="EndButton" Content="结束并保存"/></WrapPanel>
       </StackPanel>
       <Expander Header="最近的投入" Margin="0,22,0,0" Foreground="{DynamicResource Muted}">
        <StackPanel Margin="0,12,0,0"><TextBlock x:Name="HistoryEmpty" Text="每一段投入，都会留在这里。" TextWrapping="Wrap"/><StackPanel x:Name="HistoryPanel"/></StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,52" Background="{DynamicResource HudGlass}" BorderBrush="#527D9686" BorderThickness="1" CornerRadius="12" Padding="16,10,10,10">
   <StackPanel Orientation="Horizontal">
    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0"><TextBlock x:Name="FocusHint" Text="把此刻留给重要的事" Foreground="{DynamicResource HudMuted}" FontSize="12"/><TextBlock x:Name="FocusDockStatus" Text="有效专注，滋养宗门" Foreground="{DynamicResource HudInk}" Margin="0,4,0,0"/></StackPanel>
    <Button x:Name="OpenFocus" Content="准备专注  →" Background="#E9DAB5" Foreground="#263D38" Padding="22,13" FontSize="15" FontWeight="SemiBold" Margin="0"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="StatusMessage" Text="山门已候，择一位修炼者同行。" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource HudMuted}" Margin="30,0,30,16" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" FontSize="12"/>
 </Grid>
</Window>
