<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注岛 · Focus Island" Width="1120" Height="800" MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F5F4EF" FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="#263E38" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#E9EDE4"/><Setter Property="Foreground" Value="#263E38"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#FAFAF7"/><Setter Property="BorderBrush" Value="#DFE4D9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  </Window.Resources>
  <Grid Margin="28,20,28,14">
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="44" Height="44" Background="#294D40" CornerRadius="14" Margin="0,0,14,0"><TextBlock Text="岛" Foreground="#F5F4EF" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="专注岛" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="把认真投入的时间，变成自己的风景。" Foreground="#68796F" Margin="0,3,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="可用材料" Foreground="#68796F" HorizontalAlignment="Right"/><TextBlock x:Name="Wallet" Text="0.00" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="365"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#E6EDE1" CornerRadius="22" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
            <StackPanel Margin="23,16,23,0">
              <TextBox x:Name="IslandName" Text="我的专注岛" FontSize="21" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0,2" MaxLength="20" ToolTip="为这座岛起个名字，离开输入框后保存"/>
              <TextBlock x:Name="IslandSummary" Text="从第一棵树开始，慢慢长成喜欢的样子。" Foreground="#657765" Margin="0,4,0,0"/>
            </StackPanel>
            <ContentControl x:Name="IslandHost" Grid.Row="1" MinHeight="240"/>
            <StackPanel Grid.Row="2" Margin="23,8,23,18">
              <TextBlock x:Name="NextGoal" Text="下一次改变 · 一棵树 / 5 材料" FontWeight="SemiBold"/>
              <ProgressBar x:Name="BuildProgress" Height="5" Margin="0,10,0,8" Minimum="0" Maximum="100" Foreground="#648F71" Background="#D3DFCC" BorderThickness="0"/>
              <TextBlock Text="点击一块土地预览建筑。建设只在专注结束后进行。" FontSize="12" Foreground="#657765" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,16,0,0" x:Name="BuildControls">
          <TextBlock x:Name="PlotLabel" Text="地块 1 · 空地" Margin="0,0,0,8" FontWeight="SemiBold"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="BuildingKind" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="树木 · 5 材料" Tag="tree"/><ComboBoxItem Content="露营地 · 15 材料" Tag="tent"/><ComboBoxItem Content="海边小屋 · 25 材料" Tag="cottage"/></ComboBox>
            <ComboBox x:Name="BuildingColor" Grid.Column="1" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="苔绿" Tag="sage"/><ComboBoxItem Content="陶土" Tag="clay"/></ComboBox>
            <Button x:Name="BuildButton" Grid.Column="2" Content="建造" Background="#294D40" Foreground="#FFFFFF" Margin="0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="RecolorButton" Content="免费换色" Padding="12,7"/><Button x:Name="MoveButton" Content="移动建筑" Padding="12,7"/><TextBlock x:Name="MoveHint" VerticalAlignment="Center" Foreground="#68796F" TextWrapping="Wrap"/></StackPanel>
        </StackPanel>
      </Grid>
      <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="22" Padding="22,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="留一点时间，给重要的事" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,17"/>
            <StackPanel x:Name="SetupPanel">
              <TextBlock Text="这次想完成什么" Foreground="#68796F" Margin="0,0,0,6"/>
              <TextBox x:Name="TaskName" Text="读完一篇文章" MaxLength="100" Margin="0,0,0,15"/>
              <CheckBox x:Name="UseWindow" Content="在一个软件窗口里专注" IsChecked="True"/>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><ComboBox x:Name="WindowChoices" Margin="0,0,7,0"/><Button x:Name="RefreshWindows" Grid.Column="1" Content="刷新" Padding="5,5" Margin="0"/></Grid>
              <CheckBox x:Name="UseBrowser" Content="允许在选定的 Edge 页面阅读"/>
              <TextBlock x:Name="BrowserLabel" Text="尚未选择页面。在 Edge 扩展中点击“选为专注页面”。" TextWrapping="Wrap" Foreground="#68796F" FontSize="12" Margin="0,0,0,6"/>
              <Button x:Name="BrowserHelp" Content="如何连接 Edge" HorizontalAlignment="Left" Padding="9,5" Margin="0,0,0,15"/>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="分钟" Foreground="#68796F" Margin="0,0,0,6"/><ComboBox x:Name="Minutes" IsEditable="True" Text="25"><ComboBoxItem Content="5"/><ComboBoxItem Content="15"/><ComboBoxItem Content="25"/><ComboBoxItem Content="45"/><ComboBoxItem Content="60"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="专注方式" Foreground="#68796F" Margin="0,0,0,6"/><ComboBox x:Name="Mode" SelectedIndex="0"><ComboBoxItem Content="随心 · 返回继续"/><ComboBoxItem Content="挑战 · 完成额外 +20%"/></ComboBox></StackPanel>
              </Grid>
              <Button x:Name="StartButton" Content="开始专注" Background="#294D40" Foreground="#FFFFFF" Padding="12,12" Margin="0"/>
              <TextBlock Text="开始后收起到托盘。离开目标范围时，暂停累计。" Foreground="#68796F" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="SessionPanel" Visibility="Collapsed">
              <TextBlock x:Name="ActiveTask" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock x:Name="TimerText" Text="00:00" FontSize="45" Margin="0,8,0,0"/>
              <TextBlock x:Name="SessionStatus" Text="等待回到目标窗口" Foreground="#68796F" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <ProgressBar x:Name="SessionProgress" Height="6" Foreground="#648F71" Background="#E9EDE4" BorderThickness="0"/>
              <TextBlock x:Name="SessionReward" TextWrapping="Wrap" Margin="0,12,0,14"/>
              <WrapPanel><Button x:Name="PauseButton" Content="暂停"/><Button x:Name="HideButton" Content="收起继续"/><Button x:Name="EndButton" Content="结束并保存" Margin="0,8,0,0"/></WrapPanel>
            </StackPanel>
            <Border Height="1" Background="#EAEEE7" Margin="0,20,0,16"/>
            <TextBlock Text="最近的投入" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="HistoryEmpty" Text="第一段专注，会成为这座岛的起点。" Foreground="#68796F" TextWrapping="Wrap"/>
            <StackPanel x:Name="HistoryPanel"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <TextBlock x:Name="StatusMessage" Grid.Row="2" Text="本地保存 · 温和积累 · 关闭窗口后仍可从托盘回来" Foreground="#68796F" VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="12"/>
  </Grid>
</Window>
